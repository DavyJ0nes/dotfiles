#!/bin/bash
# gcloudctx - Switch between gcloud configurations
# Similar to kubectx for gcloud config configurations

set -e

# Get current active configuration
get_current_config() {
  gcloud config configurations list --format='value(name)' --filter='is_active=true' 2>/dev/null || echo ""
}

# List all configurations
list_configs() {
  gcloud config configurations list --format='value(name)' 2>/dev/null
}

# Main logic
if [ -z "$1" ]; then
  # Interactive mode
  current=$(get_current_config)
  
  # Use fzf if available, otherwise use select
  if command -v fzf &> /dev/null; then
    selected=$(list_configs | fzf --preview "echo 'Current: $current'" --preview-window=up:3)
  else
    echo "Available gcloud configurations:"
    PS3="Select configuration: "
    select selected in $(list_configs); do
      [ -n "$selected" ] && break
    done
  fi
  
  if [ -n "$selected" ]; then
    gcloud config configurations activate "$selected"
    echo "✓ Switched to: $selected"
  fi
else
  # Direct activation
  gcloud config configurations activate "$1"
  echo "✓ Switched to: $1"
fi
